{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly"],
  "prConcurrentLimit": 2,
  "separateMajorMinor": false,
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "pinDigests": false,
      "pinVersions": false
    },
    {
      "matchPackageNames": ["*"],
      "groupName": "update"
    }
  ]
}
